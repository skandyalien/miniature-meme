# AI generation and in-app study tutor require a server-side key.
# API usage is billed separately from ChatGPT subscriptions.
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4.1

# For public hosting, PRODUCTION=true and a strong nonempty password are required.
# Visit the app and enter username `lumiquiz` and your chosen password.
# Leave these unset for local demo testing without a password.
# PRODUCTION=true
# LUMIQUIZ_PASSWORD=choose-a-long-unique-password
